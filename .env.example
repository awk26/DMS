# Copy to .env and adjust. Never commit .env.

# Required for stable sessions (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me

# Branding shown in the UI
DMS_APP_NAME=Archive DMS

# Where the database and stored files live (relative paths are relative to the project folder)
DMS_INSTANCE_DIR=instance
# Stored documents and archived emails. Keep this OUTSIDE the project folder (absolute path) so it can
# be moved or backed up on its own: stop the app, move the folder as a whole, update this line, restart.
# The encryption key (master.key in DMS_INSTANCE_DIR) must stay with it, or the files cannot be read.
# Linux example: /data/dms/storage
DMS_STORAGE_DIR=D:/DMS-Data/storage
# Required: MySQL 8 (the app will not start without it). The password is used as-is.
# init_command keeps every connection on UTC.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dms_user
DB_PASSWORD=CHANGE_ME
DB_NAME=DMS
# Connection pool (optional)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# Alternative to the DB_* settings above (used only when DB_HOST is not set):
# DATABASE_URL=mysql+pymysql://dms_user:CHANGE_ME@127.0.0.1:3306/DMS?charset=utf8mb4&init_command=SET%20time_zone%3D%27%2B00%3A00%27
# Optional: database for the automated tests (default: DATABASE_URL with "_test" added to the database name).
# Its name must end in _test; every table in it is emptied after each test.
# TEST_DATABASE_URL=mysql+pymysql://dms_user:CHANGE_ME@127.0.0.1:3306/DMS_test?charset=utf8mb4&init_command=SET%20time_zone%3D%27%2B00%3A00%27

# Upload limit per file, in MB
DMS_MAX_UPLOAD_MB=50

# Web server (python app.py)
DMS_HOST=127.0.0.1
DMS_PORT=5000

# Set to true when served over HTTPS
SESSION_COOKIE_SECURE=false
# For a frontend on a different site, set SESSION_COOKIE_SAMESITE=None and SESSION_COOKIE_SECURE=true.
SESSION_COOKIE_SAMESITE=Lax

# Comma-separated exact browser origins allowed to call /api/v1 (no paths or wildcard).
DMS_CORS_ALLOWED_ORIGINS=http://localhost:4200
# Optional absolute Angular URL used as the post-login destination for SSO and Gmail OAuth callbacks.
# DMS_ANGULAR_FRONTEND_URL=http://localhost:4200

# Gmail (every user connects their own mailbox; tokens are stored encrypted in the database)
GMAIL_CREDENTIALS_FILE=credentials.json
# Only mailboxes of these domains can be connected (comma-separated; empty = any Gmail account)
# GMAIL_ALLOWED_DOMAINS=jmbaxi.com
GMAIL_SYNC_ENABLED=true
GMAIL_SYNC_INTERVAL_SECONDS=120
# Mailboxes synchronised in parallel per run
GMAIL_SYNC_WORKERS=4
# Import up to N already-archived messages when an account is first connected (0 = only newly archived)
GMAIL_INITIAL_BACKFILL=0
# When Gmail history has expired, rescan archived mail from this many days
GMAIL_RESYNC_WINDOW_DAYS=30
GMAIL_MAX_IMPORT_ATTEMPTS=5
# Allow the OAuth redirect over http for localhost only
OAUTH_ALLOW_HTTP_LOCALHOST=true

# ---------------------------------------------------------------- Security (BRD FR-SEC)
# Encryption at rest (AES-256-GCM). Customer-managed keys: either a key file you control...
DMS_ENCRYPTION_AT_REST=true
# DMS_MASTER_KEY_FILE=C:/secure/dms-master.key
# ...or keys in the environment: id:base64(32 bytes), comma-separated; the active one encrypts new files
# DMS_MASTER_KEYS=k1:BASE64KEY=
# DMS_ACTIVE_KEY_ID=k1
# ...or a KMS/HSM provider class (module:Class)
# DMS_KEY_PROVIDER=mycompany.kms:AzureKeyVaultProvider

# Encryption in transit: redirect to HTTPS and send HSTS. Serve TLS directly (TLS 1.2+) or via a proxy.
DMS_FORCE_HTTPS=false
# DMS_SSL_CERT_FILE=C:/certs/dms.crt
# DMS_SSL_KEY_FILE=C:/certs/dms.key
# Number of reverse proxies whose X-Forwarded-* headers are trusted (for client IPs / HTTPS detection)
DMS_TRUSTED_PROXIES=0
# Security response headers on every API response. Leave unset to use the defaults in dms/config.py.
# Keep them in line with the frontend web server config (DMS-FE/deploy/nginx-dms.conf).
# DMS_CONTENT_SECURITY_POLICY=default-src 'self'; img-src 'self' data: blob:; media-src 'self'; style-src 'self'; script-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com; frame-ancestors 'self'
# DMS_FRAME_OPTIONS=SAMEORIGIN
# DMS_REFERRER_POLICY=same-origin
# DMS_PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=(), payment=(), usb=()
# "Server" header sent by `python app.py` (hides the Werkzeug/Python versions)
# DMS_SERVER_HEADER=DMS
# Allow the first-administrator setup page from another machine (default: server only)
DMS_ALLOW_REMOTE_SETUP=false
# Hard ceiling for any upload request; per-file limits are set in Admin > Settings
DMS_MAX_REQUEST_MB=1024

# Malware scanning: auto | clamav | defender | builtin  (auto = ClamAV if configured, else Defender if usable)
DMS_MALWARE_SCANNER=auto
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_SOCKET=/var/run/clamav/clamd.ctl
DMS_MALWARE_FAIL_CLOSED=true

# Office previews: exact rendering when LibreOffice is installed (auto-detected if on PATH)
# LIBREOFFICE_PATH=C:/Program Files/LibreOffice/program/soffice.exe

# Background maintenance: recycle-bin expiry and version retention
DMS_MAINTENANCE_ENABLED=true
DMS_MAINTENANCE_INTERVAL_SECONDS=3600

# ---------------------------------------------------------------- Single sign-on and directories
# LDAP / Active Directory
# LDAP_URL=ldaps://dc01.corp.example.com
# LDAP_BASE_DN=DC=corp,DC=example,DC=com
# LDAP_BIND_DN=CN=svc-dms,OU=Service,DC=corp,DC=example,DC=com
# LDAP_BIND_PASSWORD=
# LDAP_USER_FILTER=(|(sAMAccountName={username})(userPrincipalName={username}))
# LDAP_CA_FILE=C:/certs/corp-ca.pem

# OpenID Connect: list provider names, then configure each one
# OIDC_PROVIDERS=entra,google
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# OIDC_ENTRA_CLIENT_ID=
# OIDC_ENTRA_CLIENT_SECRET=
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=
# Any other OIDC IdP: OIDC_<NAME>_METADATA_URL=https://idp/.well-known/openid-configuration, plus _CLIENT_ID/_CLIENT_SECRET/_LABEL

# SAML 2.0 (redirect URL / ACS: https://<host>/auth/saml/acs, metadata: https://<host>/auth/saml/metadata)
# SAML_ENABLED=true
# SAML_IDP_ENTITY_ID=https://sts.windows.net/<tenant>/
# SAML_IDP_SSO_URL=https://login.microsoftonline.com/<tenant>/saml2
# SAML_IDP_CERT_FILE=C:/certs/idp-signing.pem
# SAML_ATTR_EMAIL=email
# SAML_ATTR_GROUPS=groups

# OCR of images and scanned PDF pages for search (needs Tesseract: apt install tesseract-ocr)
# DMS_OCR_ENABLED=true
# TESSERACT_PATH=/usr/bin/tesseract
# DMS_OCR_LANGUAGES=eng
# DMS_OCR_MAX_PAGES=20
# DMS_OCR_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------- Document validity & expiry monitoring
# Folders opt in ("Enable Document Validity Monitoring"); AI extracts dates, a person confirms them, and
# a daily run sends countdown alerts from VALIDITY_NOTIFICATION_START_DAYS before expiry.
# See docs/DOCUMENT_VALIDITY.md.
VALIDITY_MONITORING_ENABLED=true
# Google Gemini (server side only; never sent to the browser). Empty key = no AI: dates are entered by hand.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TIMEOUT_SECONDS=90
# Files larger than this are sent as extracted text (PDF) or not analysed (images)
# GEMINI_MAX_INLINE_MB=18
# Below this AI confidence the result is flagged "needs review"
# VALIDITY_CONFIDENCE_THRESHOLD=0.75
VALIDITY_TIMEZONE=Asia/Kolkata
VALIDITY_SCHEDULER_TIME=09:00
VALIDITY_NOTIFICATION_START_DAYS=30
# In-process worker thread in the web app. With several web processes (gunicorn -w N) set false and run
# exactly one `flask --app app validity-worker` service instead.
VALIDITY_WORKER_ENABLED=true
# VALIDITY_WORKER_INTERVAL_SECONDS=30
# VALIDITY_JOB_MAX_ATTEMPTS=5
# VALIDITY_RETRY_BASE_SECONDS=60
# Default email preference for users who have not chosen one: off | milestones | daily
# VALIDITY_EMAIL_DEFAULT_MODE=milestones
# Absolute frontend URL for links in alert emails (default: DMS_ANGULAR_FRONTEND_URL)
# VALIDITY_APP_URL=https://dms.example.com
# Outgoing email for alert digests. Empty SMTP_HOST = in-app notifications only.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_SSL=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=DMS <dms@example.com>
